<resources>
    <style name="Theme.SteamHunter" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/hunter_ink</item>
        <item name="android:navigationBarColor">@color/hunter_background</item>
        <item name="android:statusBarColor">@color/hunter_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/hunter_background</item>
    </style>

    <style name="Theme.SteamHunter.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#050806</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_icon_v2</item>
        <item name="windowSplashScreenIconBackgroundColor">#0B1812</item>
        <item name="postSplashScreenTheme">@style/Theme.SteamHunter</item>
    </style>
</resources>
